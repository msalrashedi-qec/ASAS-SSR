<div id="recovery-panel-3" style="@PanelStyle">
    <div class="auth-header">
        <div class="page-badge">
            <span class="material-symbols-outlined">lock_reset</span>
            <span>@_localizer["SetNewPassword"]</span>
        </div>
        <h2>
            <span>@_localizer["CreateNewPassword"]</span>
        </h2>
        <p>
            <span>@_localizer["PasswordRequirements"]</span>
        </p>
    </div>

    <EditForm Model="Input" FormName="set-new-password" method="post" OnValidSubmit="OnSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="px-4 bd-callout bd-callout-danger"></ValidationSummary>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="px-4 bd-callout bd-callout-danger" role="alert">
                @errorMessage
            </div>
        }

        <input type="hidden" name="Input.UserId" value="@ResolvedUserId" />
        <input type="hidden" name="Input.ResetToken" value="@ResolvedResetToken" />
        
        <div class="mb-3">
            <label class="form-label">
                <span>@_localizer["NewPassword"]</span>
            </label>
            <div class="input-icon-wrap">
                <span class="material-symbols-outlined field-icon">lock</span>
                <InputText type="password" @bind-Value="Input.NewPassword" id="new-pass" class="form-control text-center" autocomplete="new-password" placeholder="••••••••" oninput="checkPasswordStrength(this.value)" />
            </div>
            <div id="js-strength-wrap" style="display:none;">
                <div class="strength-bar-wrap">
                    <div class="strength-bar-fill" id="js-strength-bar" style="width:0%;"></div>
                </div>
                <div id="js-strength-label"></div>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label">
                <span>@_localizer["ConfirmPassword"]</span>
            </label>
            <div class="input-icon-wrap">
                <span class="material-symbols-outlined field-icon">lock_check</span>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="confirm-pass" class="form-control text-center" autocomplete="new-password" placeholder="••••••••" />
            </div>
        </div>

        <button type="submit" class="submit-btn w-100" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>@_localizer["Processing"]</span>
            }
            else
            {
                <span>@_localizer["UpdatePassword"]</span>
            }
        </button>
    </EditForm>
</div>