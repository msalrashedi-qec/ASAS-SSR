@page "/student-documents/{Id:guid}"
@attribute [Authorize]

<div class="modal fade" id="DetailsModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="DetailsModalLabel" aria-hidden="true" data-bs-focus="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="DetailsModalLabel"> @_localizer["Details"]</h2>
                <div style="text-align: left">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            @if (isProcessing)
            {
                <LoadingBar />
            }
            <EditForm Model="_model" OnValidSubmit="SaveDataAsync">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <ValidationSummary class="bd-callout bd-callout-danger" />
                    <div class="p-2">
                        @_localizer["Type"]:
                        <InputSelect id="classification" @bind-Value="_model.TypeId" required class="form-control">
                            @foreach (var item in types)
                            {
                                <option value="@item.Id">@(_localizer["SelectedLanguage"] == "ar" ? item.NameAr : item.Name)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="p-2">
                        @_localizer["File"]:
                        <InputFile class="form-control" accept=".pdf,image/*" OnChange="OnLogoSelected" />
                    </div>
                    <div class="p-2">
                        @_localizer["Comments"]:
                        <InputTextArea class="form-control bg-yellow" @bind-Value="_model.Comments" rows="3"></InputTextArea>
                    </div>
                </div>
                <div class="modal-footer center">
                    <button type="submit" disabled="@isProcessing" class="btn btn-primary">@_localizer["Save"]</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<div class="modal fade document-preview-modal" id="DocumentPreviewModal" tabindex="-1" aria-labelledby="DocumentPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header document-preview-header document-preview-title">
                <span class="material-symbols-outlined" aria-hidden="true">description</span>
                <div>
                    <h2 class="document-preview-title" id="DocumentPreviewModalLabel">@GetDocumentTitle(previewDocument)</h2>
                </div>
                <div style="text-align: left">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body document-preview-body">
                @if (previewDocument is not null)
                {
                    @if (IsImage(previewDocument))
                    {
                        <img class="document-preview-image" src="@GetDocumentUrl(previewDocument)" alt="@GetDocumentTitle(previewDocument)" />
                    }
                    else if (IsPdf(previewDocument))
                    {
                        <iframe class="document-preview-frame" src="@GetDocumentUrl(previewDocument)" title="@GetDocumentTitle(previewDocument)"></iframe>
                    }
                    else
                    {
                        <div class="document-preview-unavailable">
                            <span class="material-symbols-outlined" aria-hidden="true">draft</span>
                            <p>@previewDocument.FileName</p>
                        </div>
                    }
                }
            </div>
            @if (previewDocument is not null)
            {
                <div class="modal-footer document-preview-footer">
                    <a class="btn btn-primary" href="@GetDocumentUrl(previewDocument)" download="@previewDocument.FileName">
                        <span class="material-symbols-outlined" aria-hidden="true">download</span>
                        @_localizer["Download"]
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@if (isLoading)
{
    <LoadingBar />
}

<header>
    <h2>@_localizer["StudentDocuments"]</h2>
</header>
    <RadzenBreadCrumb>
        <ChildContent>
            <RadzenBreadCrumbItem Path="index" Text="@_localizer["Home"]" />
            <RadzenBreadCrumbItem Text="@_localizer["StudentDocuments"]" />
        </ChildContent>
    </RadzenBreadCrumb>


<div class="p-4">
    <section class="student-summary">
        <div class="student-avatar" aria-hidden="true">
            <span class="material-symbols-outlined">school</span>
        </div>
        <div class="student-identity">
            <h3>@StudentFullName</h3>
            <div class="student-meta">
                <span><strong>@StudentCode</strong></span>
            </div>
        </div>
    </section>

    <button type="button" class="submit-btn px-3 mt-4" @onclick="New" data-bs-toggle="modal" data-bs-target="#DetailsModal">
        @_localizer["New"]
    </button>
    <div class="row mt-3">
        <div class="col-md-3 p-2">
            @_localizer["Year"]:
            <RadzenDropDown @bind-Value=@selectedYearId Data=@years TextProperty="Name" ValueProperty="Id" Change="@GetListAsync" class="form-control" />
        </div>
    </div>
    
    <div class="overflow-auto mt-4">
        <table class="table">
            <thead>
                <tr>
                    <th>@_localizer["File"]</th>
                    <th>@_localizer["Type"]</th>
                    <th>@_localizer["Comments"]</th>
                    <th>@_localizer["Year"]</th>
                    <th>@_localizer["Status"]</th>
                    <th>@_localizer["Action"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in studentDocuments)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.FilePath))
                            {
                                <button type="button" class="document-thumbnail" title="@_localizer["View"]" aria-label="@_localizer["View"]"
                                        @onclick="() => View(item)" data-bs-toggle="modal" data-bs-target="#DocumentPreviewModal">
                                    @if (IsImage(item))
                                    {
                                        <img src="@GetDocumentUrl(item)" alt="@GetDocumentTitle(item)" />
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined document-file-icon" aria-hidden="true">picture_as_pdf</span>
                                    }
                                </button>
                            }
                            else
                            {
                                <span class="material-symbols-outlined document-file-icon" aria-hidden="true">draft</span>
                            }
                        </td>
                        <td>@GetDocumentTitle(item)</td>
                        <td>@item.Comments</td>
                        <td>@item.YearName</td>
                        <td>
                            <span class="tag" style="background-color:@item.ColorCode">
                                @(_localizer["SelectedLanguage"] == "ar" ? item.StatusNameAr : item.StatusName)
                            </span>
                        </td>
                        <td>
                            <div class="document-actions">
                                <button type="button" class="document-action-button" title="@_localizer["Edit"]" aria-label="@_localizer["Edit"]"
                                        @onclick="() => Edit(item)" data-bs-toggle="modal" data-bs-target="#DetailsModal">
                                    <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
