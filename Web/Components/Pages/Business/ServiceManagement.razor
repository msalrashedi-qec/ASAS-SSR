@page "/service-management"


<PageTitle>Service Management</PageTitle>

<div class="modal fade" id="DetailsModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="DetailsModalLabel" aria-hidden="true" data-bs-focus="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="DetailsModalLabel"> @_localizer["Details"]</h2>
                <div style="text-align: left">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            @if (isProcessing)
            {
                <LoadingBar />
            }
            <EditForm Model="_model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <ValidationSummary class="bd-callout bd-callout-danger"></ValidationSummary>
                    <div class="row">
                        <div class="p-2">
                            @_localizer["NameEn"]:
                            <InputText class="form-control" @bind-Value="_model.Name" maxlength="50" />
                        </div>
                               
                        <div class="p-2">
                            @_localizer["NameAr"]:
                            <InputText class="form-control" @bind-Value="_model.NameAr" maxlength="50" />
                        </div>
                               
                        <div class="p-2">
                            @_localizer["Category"]:
                            <select class="form-control" @bind="_model.CategoryId">
                                @foreach (var item in categories)
                                {
                                    <option value="@item.Id">@(_localizer["SelectedLanguage"] == "ar" ? item.NameAr : item.Name)</option>
                                }
                            </select>
                        </div>
                        <div class="p-2">
                            @_localizer["DefaultTax"]:
                            <InputNumber class="form-control text-center" @bind-Value="_model.DefaultTax" maxlength="10" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer center">
                    <button type="submit" disabled="@isProcessing" class="btn btn-primary">
                        @_localizer["Save"]
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<div class="modal fade" id="PricingModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="PricingModalLabel" aria-hidden="true" data-bs-focus="false">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="PricingModalLabel"> @_localizer["ServicePricing"]</h2>
                <div style="text-align: left">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            @if(_model.Id > 0)
            {
                <ServicePricing ServiceId="_model.Id" />
            }
        </div>
    </div>
</div>


@if (isLoading)
{
    <LoadingBar />
}
<header>
     <h2>
            @_localizer["Services"]
        </h2>
</header>
    <RadzenBreadCrumb>
        <ChildContent>
            <RadzenBreadCrumbItem Path="index" Text="@_localizer["Home"]" />
            <RadzenBreadCrumbItem Path="cpanel" Text="@_localizer["Cpanel"]" />
            <RadzenBreadCrumbItem Text="@_localizer["Services"]" />
        </ChildContent>
    </RadzenBreadCrumb>


<div class="content-body">
   
    <div class="p-4">
        <button type="button" class="btn btn-outline-primary" @onclick="() => New()" data-bs-toggle="modal" data-bs-target="#DetailsModal">
            @_localizer["New"]
        </button>

        <div class="overflow-auto pt-3">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@_localizer["Service"]</th>
                        <th>@_localizer["Category"]</th>
                        <th>@_localizer["Year"]</th>
                        <th>@_localizer["Action"]</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (var item in services)
                        {
                            <tr>
                                <td>@(index++)</td>
                                <td>@(_localizer["SelectedLanguage"] == "ar" ? item.NameAr : item.Name)</td>
                                <td>@(_localizer["SelectedLanguage"] == "ar" ? item.CategoryNameAr : item.CategoryName)</td>
                                <td>@item.YearName</td>
                                <td>
                                    @if(item.CategoryId > 19)
                                    {
                                        <span class="material-symbols-outlined icon c-blue pointer" @onclick="() => Edit(item)" data-bs-toggle="modal" data-bs-target="#DetailsModal">
                                            edit
                                        </span>
                                      
                                        <span class="material-symbols-outlined icon c-red pointer" @onclick="() => Edit(item)" data-bs-toggle="modal" data-bs-target="#PricingModal">
                                            local_atm
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    
</div>
