@page "/share-task"

@if (isLoading)
{
    <LoadingBar />
}
<header>
    <h4>@_localizer["ShareTasks"]</h4>
</header>
<div class="p-2">
    <RadzenBreadCrumb>
        <ChildContent>
            <RadzenBreadCrumbItem Path="index" Text="@_localizer["Home"]" />
            <RadzenBreadCrumbItem Path="cpanel" Text="@_localizer["Cpanel"]" />
            <RadzenBreadCrumbItem Text="@_localizer["ShareTasks"]" />
        </ChildContent>
    </RadzenBreadCrumb>
</div>
<div class="content-body">

    <div class="card m-2">
        <div class="card-header">
            @_localizer["Search"]
        </div>
        <div class="card-body">
            <EditForm Model="search" OnSubmit="GetListAsync">
                <div class="row">
                   
                    <div class="col-md-2 p-2">
                        <InputText @bind-Value=@search.RefNo placeholder="@_localizer["ProcessId"]" class="form-control text-center"></InputText>
                    </div>
                    <div class="col-md-3 p-2">
                        <RadzenDropDown @bind-Value=@selectedTypes Data=@types TextProperty="Name" ValueProperty="Id"
                                        Multiple=true Placeholder="@_localizer["Type"]" Chips=true class="form-control" />
                    </div>

                    <div class="col-md-2 p-2">
                        <button type="submit" class="btn btn-outline-primary w-100">
                            @_localizer["Search"]
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
    @if (!isLoading)
    {
        <div class="p-3">
            <div class="row bg-body-tertiary" style="font-size:small;">
                <div class="col-4">
                    @_localizer["PageNo"]
                    <select class="pagination-select" @bind-value="PageIndex" @onchange="GetListAsync" @bind-value:event="oninput">
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="col-4 text-center">
                    @_localizer["RowsCount"] : @totalRows
                </div>
                <div class="col-4 align-content-end">
                    @_localizer["RowsPerPage"]
                    <select class="pagination-select" @bind-value="PageSize" @onchange="GetListAsync" @bind-value:event="oninput">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="500">500</option>
                    </select>
                </div>
            </div>
            <div class="overflow-auto" style="max-height:500px;">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th><input class="form-check-input" type="checkbox" @onchange="@((e) => UpdateSelection(e))"></th>
                            <th>@_localizer["ProcessId"]</th>
                            <th>@_localizer["Type"]</th>
                            <th>@_localizer["RequestedFor"]</th>
                            <th>@_localizer["CurrentTask"]</th>

                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = PageSize * (PageIndex - 1) + 1;
                            if (tasks != null)
                            {
                                foreach (var item in tasks)
                                {
                                    <tr>
                                        <td>@index</td>
                                        <td><input class="form-check-input" type="checkbox" @bind="@item.IsSelected"></td>
                                        <td>
                                            <a href="process-details/@item.WfProcessId">
                                                @item.RefNo
                                            </a>
                                        </td>
                                        <td>
                                            @item.TypeName
                                        </td>
                                        <td>
                                            @item.RequesterName
                                        </td>
                                        <td>
                                            @item.TaskName
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row">
                <div class="col-md-6 p-2">
                    <strong>@_localizer["Name"] :  </strong>
                    <RadzenDropDown required @bind-Value=dto.SharedWithUserId AllowVirtualization="true"
                                    AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data=@users TextProperty="Name" ValueProperty="Id" Style="width: 100%;" />
                </div>
                <div class="col-md-3 p-2">
                    @_localizer["StartDate"]:
                    <input type="date" required class="form-control text-center" @bind-value="dto.StartDate" />
                </div>
                <div class="col-md-3 p-2">
                    @_localizer["EndDate"]:
                    <input type="date" required class="form-control text-center" @bind-value="dto.EndDate" />
                </div>
                <div class="col-md-12 p-2">
                    @_localizer["Comments"]:
                    <textarea class="form-control bg-yellow" maxlength="1000" @bind=dto.Comments />
                </div>
            </div>

            <div class="text-center py-2">
                <button class="btn btn-primary" @onclick=ShareAsync>
                    @_localizer["Share"]
                </button>
            </div>
        </div>
    }
</div>