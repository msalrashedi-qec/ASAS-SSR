@page "/discount-request"
@attribute [Authorize]


<PageTitle>@_localizer["DiscountRequest"]</PageTitle>

@if (isLoading)
{
    <LoadingBar />
}

<header>
    <h2>@_localizer["DiscountRequest"]</h2>
</header>
<RadzenBreadCrumb>
    <ChildContent>
        <RadzenBreadCrumbItem Path="index" Text="@_localizer["Home"]" />
        <RadzenBreadCrumbItem Path="inbox" Text="@_localizer["Requests"]" />
        <RadzenBreadCrumbItem Text="@_localizer["DiscountRequest"]" />
    </ChildContent>
</RadzenBreadCrumb>
<div class="content-body">
    <div class="card m-2">
        <div class="card-header">@_localizer["StudentInfo"]</div>
        <div class="card-body row">
            <div class="col-md-4 p-2">
                <label>@_localizer["Name"]</label>
                <SearchFocusedDropDown PopupStyle="max-height:300px;overflow-y:scroll;overflow-x:hidden;scrollbar-gutter:stable;scrollbar-width:auto" @bind-Value=@_model.StudentId Data=@students TextProperty="Name" ValueProperty="Id" Disabled="@(!canEdit || ProcessId.HasValue)" Change="OnStudentChangedAsync"
                            AllowVirtualization="true" AllowFiltering=true FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Placeholder="@_localizer["StudentName"]" class="form-control" />
            </div>
            @if (students.Count == 0 && !isLoading)
            {
                <div class="col-12">
                    <div class="bd-callout bd-callout-warning mt-3">@_localizer["NoStudentsFound"]</div>
                </div>
            }
            @if (student is not null)
            {
                <div class="col-md-3 p-2">
                    <label>@_localizer["Level"] - @_localizer["Class"]</label>
                    <div class="form-control">@StudentLevelAndClass</div>
                </div>
                <div class="col-md-2 p-2">
                    <label>@_localizer["Status"]</label>
                    <div class="form-control">@StudentStatus</div>
                </div>
                <div class="col-md-3 p-2">
                    <label>@_localizer["RemainingAmount"]</label>
                    <div class="form-control fw-bold text-center @(RemainingBalance > 0 ? "c-red" : "c-green")" dir="ltr">@ReportFormatter.Amount(RemainingBalance)</div>
                </div>
            }
        </div>
    </div>

    @if (student is null && _model.StudentId != Guid.Empty && !isLoading)
    {
        <div class="bd-callout bd-callout-warning m-2">@_localizer["NotFound"]</div>
    }
    else if (student is not null)
    {
        <div class="card m-2">
            <div class="card-header">@_localizer["RequestDetails"]</div>
            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />
                <div class="card-body">
                    <ValidationSummary class="bd-callout bd-callout-danger" />
                    <div class="row">
                        <div class="col-md-4 p-2">
                            <label>@_localizer["RequestType"] <span class="c-red">*</span></label>
                            <RadzenDropDown @bind-Value="_model.DiscountId" Data="discountTypes" Disabled="@(!canEdit)" TextProperty="@DiscountTextProperty" ValueProperty="Id"
                                            Change="OnDiscountChangedAsync" Placeholder="@_localizer["SelectDiscount"]" class="form-control" Style="width:100%" />
                        </div>
                        @if (_model.DiscountId > 0)
                        {
                            <div class="col-12 p-2 overflow-auto">
                                <table class="table table-striped table-bordered align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width:80px">@_localizer["Select"]</th>
                                            <th>@_localizer["Semester"]</th>
                                            <th>@_localizer["DueItem"]</th>
                                            <th>@_localizer["RemainingAmount"]</th>
                                            <th class="text-center">@_localizer["DiscountPercentage"]</th>
                                            <th class="text-center">@_localizer[IsSettlement ? "SettlementValue" : "DiscountValue"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (_model.Details.Count == 0)
                                        {
                                            <tr><td colspan="6" class="text-center">@_localizer["NoData"]</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var detail in _model.Details.OrderBy(x=> x.SemesterId).ThenBy(x=> x.CategoryId))
                                            {
                                                <tr>
                                                    <td class="text-center">
                                                        @if (!IsAutomaticTax(detail))
                                                        {
                                                            <InputCheckbox @bind-Value="detail.IsSelected" disabled="@(!canEdit)" @bind-Value:after="() => OnSemesterSelectionChanged(detail)" />
                                                        }
                                                    </td>
                                                    <td>@SemesterName(detail)</td>
                                                    <td>@(IsArabic ? detail.ItemNameAr : detail.ItemName)</td>
                                                    <td dir="ltr">@ReportFormatter.Amount(detail.RemainingAmount)</td>
                                                    <td class="text-center" dir="ltr">@(detail.IsSelected && detail.Percentage > 0 ? $"{ReportFormatter.Amount(detail.Percentage)} %" : "-")</td>
                                                    <td class="text-center" dir="ltr">
                                                        @if (!canEdit || IsAutomaticTax(detail) || (!IsSettlement && detail.HasConfiguredPercentage))
                                                        {
                                                            <span>@(detail.IsSelected ? ReportFormatter.Amount(detail.Amount) : "-")</span>
                                                        }
                                                        else
                                                        {
                                                            <InputNumber @bind-Value="detail.Amount" @bind-Value:after="SynchronizeTaxDiscounts" lang="en" class="form-control text-center" min="@(IsSettlement ? null : "0")" step="0.01" disabled="@(!canEdit || !detail.IsSelected)" />
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="fw-bold">
                                            <td colspan="5">@_localizer[IsSettlement ? "Total" : "TotalDiscount"]</td>
                                            <td class="text-center" dir="ltr">@ReportFormatter.Amount(TotalDiscount)</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        <div class="col-12 p-2">
                            <label>@_localizer["RequestReason"] <span class="c-red">*</span></label>
                            <InputTextArea class="form-control" disabled="@(!canEdit)" @bind-Value="_model.Comments" rows="4" maxlength="1000" />
                        </div>
                        @if (canEdit)
                        {
                            <div class="col-12 p-2">
                                <label>@_localizer["Attachment"]</label>
                                <InputFile OnChange="UploadFilesAsync" multiple class="form-control" />
                                @if (attachments.Count > 0)
                                {
                                    <div class="mt-2">
                                        @foreach (var attachment in attachments.ToList())
                                        {
                                            <span class="badge badge-info p-2 me-2 mb-2 fs-xs">
                                                @attachment.FileName
                                                <button type="button" class="btn-close ms-2 fs-xs" aria-label="@_localizer["Remove"]" @onclick="() => RemoveAttachment(attachment)"></button>
                                            </span>
                                        }
                                    </div>
                                }
                                <small class="fs-xs c-red">@_localizer["AttachmentsMaximum25MB"]</small>
                            </div>
                        }
                    </div>
                </div>
                @if (canEdit)
                {
                    <div class="card-footer text-center">
                        <button type="submit" class="submit-btn" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>@_localizer["Processing"]</span>
                            }
                            else
                            {
                                <span>@_localizer["Save"]</span>
                            }
                        </button>
                    </div>
                }
                
            </EditForm>
        </div>

    }
</div>
