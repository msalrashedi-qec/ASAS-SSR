@page "/discount-management"


<PageTitle>Discount Management</PageTitle>

<div class="modal fade" id="DetailsModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="DetailsModalLabel" aria-hidden="true" data-bs-focus="false">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="DetailsModalLabel"> @_localizer["Details"]</h2>
                <div style="text-align: left">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            @if (isProcessing)
            {
                <LoadingBar />
            }
            <EditForm Model="_model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <ValidationSummary class="bd-callout bd-callout-danger"></ValidationSummary>
                    <div class="row px-2">
                        <div class="col-md-4 p-2">
                            @_localizer["NameEn"]:
                            <InputText class="form-control" @bind-Value="_model.Name" maxlength="50" required />
                        </div>
                               
                        <div class="col-md-4 p-2">
                            @_localizer["NameAr"]:
                            <InputText class="form-control" @bind-Value="_model.NameAr" maxlength="50" required />
                        </div>
                               
                        <div class="col-md-4 p-2">
                            @_localizer["TransactionType"]:
                            <select class="form-control" @bind="_model.TransactionTypeId" required>
                                @foreach (var item in transactionTypes)
                                {
                                    <option value="@item.Id">@(_localizer["SelectedLanguage"] == "ar" ? item.NameAr : item.Name)</option>
                                }
                            </select>
                        </div>
                               
                        <div class="col-md-4 p-2">
                            @_localizer["Type"]:
                            <select class="form-control" @bind="_model.TypeId" required>
                                @foreach (var item in types)
                                {
                                    <option value="@item.Id">@(_localizer["SelectedLanguage"] == "ar" ? item.NameAr : item.Name)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 p-2">
                            @_localizer["Service"]
                            <RadzenDropDown @bind-Value=@_model.ServiceCategoryId Data=@serviceCategories TextProperty="@_localizer["FieldName"]" ValueProperty="Id" class="form-control" />
                        </div>

                        <div class="col-md-4 p-2">
                            @_localizer["DependOn"]:
                            <select class="form-control" @bind="_model.DependencyId" required>
                                @foreach (var item in dependsOnTypes)
                                {
                                    <option value="@item.Id">@(_localizer["SelectedLanguage"] == "ar" ? item.NameAr : item.Name)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 p-2">
                            @_localizer["DiscountApplicationTiming"]:
                            <select class="form-control" @bind="_model.ApplicationTiming" required>
                                @foreach (var timing in applicationTimings)
                                {
                                    <option value="@timing">@_localizer[$"DiscountApplicationTiming_{timing}"]</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 p-2">
                            @_localizer["SN"]:
                            <InputNumber class="form-control text-center" @bind-Value="_model.SN" maxlength="10" />
                        </div>
                       
                        <div class="col-md-4 p-2">
                            <div>
                                @_localizer["IsCancelledOnWithdrawal"]:
                            </div>
                            <InputCheckbox id="IsCancelledOnWithdrawal" class="form-check-input" @bind-Value="_model.IsCancelledOnWithdrawal" />
                        </div>
                        <div class="col-md-4 p-2">
                            <div>
                                @_localizer["IsAddedToContract"]:
                            </div>
                            <InputCheckbox id="IsAddedToContract" class="form-check-input" @bind-Value="_model.IsShownInContract" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer center">
                    <button type="submit" disabled="@isProcessing" class="btn btn-primary">
                        @_localizer["Save"]
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@if (isLoading)
{
    <LoadingBar />
}
<header>
    <h2>
            @_localizer["ManageDiscounts"]
        </h2>
</header>
<RadzenBreadCrumb>
        <ChildContent>
            <RadzenBreadCrumbItem Path="index" Text="@_localizer["Home"]" />
            <RadzenBreadCrumbItem Path="cpanel" Text="@_localizer["Cpanel"]" />
            <RadzenBreadCrumbItem Text="@_localizer["ManageDiscounts"]" />
        </ChildContent>
    </RadzenBreadCrumb>
<div class="content-body">
   
    <div class="p-4">
        <button type="button" class="btn btn-outline-primary" @onclick="() => New()" data-bs-toggle="modal" data-bs-target="#DetailsModal">
            @_localizer["New"]
        </button>

        <div class="overflow-auto pt-3">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@_localizer["Discount"]</th>
                        <th>@_localizer["Service"]</th>
                        <th>@_localizer["Category"]</th>
                        <th>@_localizer["Type"]</th>
                        <th>@_localizer["Dependency"]</th>
                        <th>@_localizer["DiscountApplicationTiming"]</th>
                        <th>@_localizer["SN"]</th>
                        <th>@_localizer["IsShownInContract"]</th>
                        <th>@_localizer["IsCancelledOnWithdrawal"]</th>
                        <th>@_localizer["Action"]</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (var item in discounts)
                        {
                            <tr>
                                <td>@(index++)</td>
                                <td>@(_localizer["SelectedLanguage"] == "ar" ? item.NameAr : item.Name)</td>
                                <td>@(_localizer["SelectedLanguage"] == "ar" ? item.ServiceCategoryNameAr : item.ServiceCategoryName)</td>
                                <td>@(_localizer["SelectedLanguage"] == "ar" ? item.TransactionTypeNameAr : item.TransactionTypeName)</td>
                                <td>@(_localizer["SelectedLanguage"] == "ar" ? item.TypeNameAr : item.TypeName)</td>
                                <td>@(_localizer["SelectedLanguage"] == "ar" ? item.DependencyNameAr : item.DependencyName)</td>
                                <td>@_localizer[$"DiscountApplicationTiming_{item.ApplicationTiming}"]</td>
                                <td class="text-center">@item.SN</td>
                                <td class="text-center">
                                    @if (item.IsShownInContract)
                                    {
                                        <span class="material-symbols-outlined c-green">
                                            check_circle
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if(item.IsCancelledOnWithdrawal)
                                    {
                                        <span class="material-symbols-outlined c-green">
                                            check_circle
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="material-symbols-outlined icon c-blue pointer" @onclick="() => Edit(item)" data-bs-toggle="modal" data-bs-target="#DetailsModal" title="@_localizer["Edit"]">
                                        edit
                                    </span>

                                    <a href="discount-config/@item.Id" >
                                        <span class="material-symbols-outlined icon c-red" title="@_localizer["Configuration"]">
                                            local_atm
                                        </span>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    
</div>
