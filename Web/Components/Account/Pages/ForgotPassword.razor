@page "/Account/ForgotPassword"
@layout AnonymousLayout

@using Web.Components.Partial.Account

<PageTitle>Forgot your password?</PageTitle>

<div class="form-side login-card">
    <div class="auth-page">

        <!-- ── Visual Panel ── -->
        <div class="auth-visual" style="background: var(--primary-gradient)">
            <div class="auth-blob auth-blob-1"></div>
            <div class="auth-blob auth-blob-2"></div>

            <div class="auth-visual-inner fade-in-up">
                <div class="auth-visual-logo-icon">
                    <span class="material-symbols-outlined">lock_reset</span>
                </div>
                <h2 style="font-size: 28px;
                    font-weight: 700;
                    margin-bottom: 15px;
                    letter-spacing: 0.5px;">
                    @_localizer["AccountRecovery"]
                </h2>
                <p>
                    @_localizer["AccountRecoveryDescription"]
                </p>
            </div>

            <!-- Recovery tips -->
            <div class="auth-stats fade-in-up-2">
                <div class="auth-stat" style="flex:none;width:100%;max-width:280px;text-align:start;">
                    <div style="display:flex;flex-direction:column;gap:.6rem;">
                        <div style="display:flex;align-items:center;gap:.6rem;font-size:.82rem;opacity:.9;">
                            <span class="material-symbols-outlined icon-fill" style="font-size:16px;color:var(--accent-400);">check_circle</span>
                            <span>@_localizer["CheckInbox"]</span>
                        </div>
                        <div style="display:flex;align-items:center;gap:.6rem;font-size:.82rem;opacity:.9;">
                            <span class="material-symbols-outlined icon-fill" style="font-size:16px;color:var(--accent-400);">check_circle</span>
                            <span>@_localizer["CodeValid"]</span>
                        </div>
                        <div style="display:flex;align-items:center;gap:.6rem;font-size:.82rem;opacity:.9;">
                            <span class="material-symbols-outlined icon-fill" style="font-size:16px;color:var(--accent-400);">check_circle</span>
                            <span>@_localizer["ChooseStrongPassword"]</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Form Area ── -->
        <div class="auth-form-area">
            <div class="auth-card fade-in-up">
                <!-- Topbar -->
                <div class="auth-topbar">
                    <a href="Account/Login" class="btn btn-ghost btn-sm d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined js-back-icon" style="font-size:17px;">arrow_back</span>
                        <span>@_localizer["BackToLogin"]</span>
                    </a>
                </div>

                <!-- Steps Indicator -->
                <div class="recovery-steps">
                    <div class="@GetRecoveryStepClass(1)" id="recovery-step-dot-1">
                        <div class="step-dot">1</div>
                        <span class="step-label">@_localizer["Email"]</span>
                    </div>
                    <div class="@GetRecoveryStepClass(2)" id="recovery-step-dot-2">
                        <div class="step-dot">2</div>
                        <span class="step-label">@_localizer["OTP"]</span>
                    </div>
                    <div class="@GetRecoveryStepClass(3)" id="recovery-step-dot-3">
                        <div class="step-dot">3</div>
                        <span class="step-label">@_localizer["Password"]</span>
                    </div>
                </div>

                <!-- ── STEP 1: Email ── -->
                <SendRecoveryCode Visible="@(currentStep == 1)" OnCodeSent="ShowCodeStep" />

                <!-- ── STEP 2: OTP ── -->
                <ResetCodeVerification Visible="@(currentStep == 2)" UserId="@userId" OnCodeVerified="ShowPasswordStep" OnCodeRejected="ShowCodeStep" />

                <!-- ── STEP 3: New Password ── -->
                <SetNewPassword Visible="@(currentStep == 3)" OnError="ShowPasswordStep" UserId="@userId" ResetToken="@resetToken" />

            </div>
        </div>
    </div>

</div>


@code {
    private string userId = string.Empty;
    private string resetToken = string.Empty;

    private int currentStep = 1;

    private void ShowCodeStep(string id)
    {
        userId = id;
        currentStep = 2;
    }

    private void ShowPasswordStep(PasswordResetContext context)
    {
        userId = context.UserId;
        resetToken = context.ResetToken;
        currentStep = 3;
    }

    private void ShowPasswordStep(string id)
    {
        userId = id;
        currentStep = 3;
    }

    private string GetRecoveryStepClass(int step)
    {
        if (step < currentStep)
        return "recovery-step step-done";

        return step == currentStep
            ? "recovery-step step-active"
            : "recovery-step";
    }
}
